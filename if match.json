if match:
            clean_text = match.group(1).strip()
    try:
        return json.loads(clean_text)
    except json.JSONDecodeError:
        st.sidebar.error("⚠️ Parser Fallback applied: Cleaned unexpected JSON structural characters.")
        return fallback_schema

# ═══════════════════════════════════════════════════════
#  CONCURRENT ASYNC AGENT PIPELINE RUNNER
# ═══════════════════════════════════════════════════════

async def execute_swarm_async(raw_input: str, actuals_payload: str, store: DualRAGStore, models: dict):
    # Step 1: Immutable Source RAG Ingestion
    store.ingest_source(raw_input)
    
    # Step 2: Orchestrator Routing Logic (Sinbad)
    orchestrator = models["orchestrator"]
    directive_response = await asyncio.to_thread(
        orchestrator.generate_content, f"Analyze and delegate this project dossier:\n\nInput Document SOW:\n{raw_input}"
    )
    directive = directive_response.text
    
    # Step 3: Dispatch Worker Swarm concurrently using asyncio.gather()
    pm_worker = models["pm_agent"]
    tech_worker = models["risk_agent"]
    cog_worker = models["cognitive"]
    
    pm_future = asyncio.to_thread(pm_worker.generate_content, f"Process financials & EVM:\n\nDirective Context:\n{directive}\n\nDocument SOW:\n{raw_input}\n\n{actuals_payload}")
    tech_future = asyncio.to_thread(tech_worker.generate_content, f"Extract technical risk RAID/RACI:\n\nDirective Context:\n{directive}\n\nDocument SOW:\n{raw_input}")
    cog_future = asyncio.to_thread(cog_worker.generate_content, f"Analyze stakeholder communication & timelines:\n\nDirective Context:\n{directive}\n\nDocument SOW:\n{raw_input}")
    
    pm_res, tech_res, cog_res = await asyncio.gather(pm_future, tech_future, cog_future)
    
    # Parse and write to isolated Agent Output Store
    parsed_pm = safe_parse_json(pm_res.text, PM_FALLBACK)
    parsed_tech = safe_parse_json(tech_res.text, TECH_FALLBACK)
    parsed_cog = safe_parse_json(cog_res.text, COG_FALLBACK)
    
    store.write_agent_output("pm_agent", parsed_pm)
    store.write_agent_output("risk_agent", parsed_tech)
    store.write_agent_output("cognitive_agent", parsed_cog)
    
    return {
        "directive": directive,
        "pm_raw": pm_res.text,
        "tech_raw": tech_res.text,
        "cog_raw": cog_res.text,
        "pm_parsed": parsed_pm,
        "tech_parsed": parsed_tech,
        "cog_parsed": parsed_cog
    }

